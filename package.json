{
  "name": "tab-explorer-landing",
  "version": "1.0.0",
  "description": "Official landing page for TAB Explorer Chrome Extension",
  "homepage": "https://tabexplorer.site",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.48.0",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "react-scripts": "5.0.1",
